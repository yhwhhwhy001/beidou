#!/bin/bash
# 北斗 V5 — 推送前密钥扫描
#
# 这个 hook 补的是一个具体的洞，写清楚它是什么，免得下次有人觉得它和 pre-commit 重复：
#
#   **GitHub 的 push protection 认不出 Binance 的密钥。**  2026-09-19 核实：Binance 不在
#   GitHub secret scanning 的 partner pattern 列表里，而能自己加模式的 custom patterns
#   要求仓库属于**组织**并启用付费的 Secret Protection（$19/月/committer）。本仓库是个人
#   账户下的公开仓库，两条都不满足。
#
#   于是服务端那一层对本仓库**最关键的那个密钥**是无效的——它拦得住 GitHub token、AWS、
#   OpenAI 这些 partner pattern，拦不住 Binance 的 key/secret。而 CI 的 Secrets 门是
#   **事后**的：它在推送之后才跑，那时密钥已经躺在公开仓库里了。
#
#   所以 Binance 密钥在「进入公开仓库之前」的拦截，只剩本机这两个 hook。
#
# 与 pre-commit 的分工：pre-commit 只看这一次的暂存区，pre-push 看**将要进入远端的全部
# commit**。两者不重复——用 `--no-verify` 提交过、或者从别处 cherry-pick 进来的东西，
# pre-commit 没见过，这里是最后一次机会。
#
# 「全部 commit」包括 merge 提交，而这要显式要求（2026-09-28 补）。gitleaks 的 git 模式跑的是
# `git log -p`，它默认不给 merge 提交出 diff。于是解冲突时写进 merge 提交的东西，此前这里
# 一直看不见：临时仓库里在冲突解法里写一个伪造的 Binance 形态，这里报 `no leaks found`。
# 下面 range 前面的 `--diff-merges=separate` 让每个 parent 各出一份 diff。
#
# 不写成 `-m`：`-m` 只说「给 merge 出 diff」，格式听 git 配置 `log.diffMerges` 的。它设成
# `combined` 或 `dense-combined` 时，出来的是 gitleaks 解析不了的合并格式，照样静默漏扫。
# `tests/architecture/test_secret_scanning_is_alive.py` 直接跑这个 hook，两种配置都要拦下。
#
# 这一层同样能被 `git push --no-verify` 绕过。没有办法让它不能——本机的东西都归使用者管。
# 它挡的是手滑。

set -uo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: 没找到 gitleaks，推送前的密钥扫描没有跑（brew install gitleaks）" >&2
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
z40="0000000000000000000000000000000000000000"
failed=0   # 扫到了疑似密钥
broken=0   # 扫描没有跑完：gitleaks 调 git log 时 git 失败了，或者 gitleaks 自己出错
# 有命中时让 gitleaks 用这个码退出（`--exit-code`）。gitleaks 自己出错时退 1、2 或 126，
# 取一个离它们都远的值。为什么要分开，见循环里那条命令上面的注释。
leaks_rc=42

# gitleaks 的 stdout 照旧给终端。循环里只截它的 stderr，见下面 fail-closed 那段。
exec 3>&1

# stdin 每行是：<local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
    # 删除远端分支：没有内容要扫。
    [ "$local_sha" = "$z40" ] && continue

    if [ "$remote_sha" = "$z40" ]; then
        # 新分支。扫「本地有、任何远端分支都没有」的 commit，而不是扫整个历史——
        # 整个历史归 CI 的 Secrets 门和 `gitleaks detect` 手动审计。
        range="$local_sha --not --remotes"
    elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        # 远端的 tip 本地没有（2026-09-29 补）。remote_sha 是远端报来的值，不保证 fetch 过。
        # `git push --force` 盖过别处推上去、这里没 fetch 的提交时就是这样。不加 --force
        # 也会走到这里：git 把这一行标成 fetch first，照样交给 hook，hook 跑完才拒。
        # 此前这里照样拼 `remote..local`。range 无效，git log 直接 fatal，一个 commit 都没扫
        # 就放行。临时仓库里实测，伪造凭据随强推进了远端。现在退回新分支的扫法。
        echo "pre-push: 远端 $remote_ref 的 tip ${remote_sha:0:12} 本地没有（没 fetch 过？），改扫本地有、任何远端分支都没有的 commit" >&2
        range="$local_sha --not --remotes"
    fi

    # 这个范围可能是空的（例如重推一个已经在远端的 commit）。空范围下 gitleaks
    # 会正常返回 0，不需要特别处理。
    #
    # fail-closed（2026-09-29 补）。gitleaks 按单个空格切 `--log-opts`，再原样交给
    # `git log -p -U0`。git 失败时它不改退出码：range 无效、多一个空格、选项拼错、ref 坏了，
    # git 都会 fatal，而 gitleaks 8.30.1 只记一行 `ERR [git] fatal: ...`，照样输出
    # `no leaks found`、返回 0（2026-09-28 实测）。此前 stderr 丢进 /dev/null，这看起来和
    # 「扫描通过」一样。现在截下 stderr，出现 `[git]` 就当扫描失败。git 的几句已知提示
    # （rename 上限之类）gitleaks 记成 WRN，不带这个前缀，不会误拦（2026-09-29 实测）。
    #
    # `--verbose`（2026-09-29 补）把每处命中打到 stdout：commit、文件、行号、规则。值由
    # `--redact` 脱敏。stdout 经 fd 3 照旧给终端，下面拦截框里的「上面列出了」指的就是它。
    # 此前没带这个参数，gitleaks 只在 stderr 报一句 `leaks found`。stderr 又只转 `[git]`
    # 那几行，被拦时屏幕上只剩拦截框。`--verbose` 不改 stderr，干净的扫描也不多打一行
    # （2026-09-29 实测）。`--no-color` 让命中清单与转出去的 `[git]` 行都不带色码。
    #
    # `--exit-code`（2026-09-29 补）把「有命中」与「gitleaks 自己出错」分开。gitleaks 有命中时
    # 默认退 1，可它自己出错时也退 1：配置读不了、扫描中途失败。规则里有 RE2 不支持的正则时
    # 它 panic，退 2。以上是 8.30.1 实测，并对过源码的 `findingSummaryAndExit`。此前这里只看
    # 退出码非 0，配置坏了也出「有疑似密钥」的框。框里叫人去作废重发 key，gitleaks 的原话
    # 却被吞掉。现在有命中时退 `$leaks_rc`。别的非 0 都当扫描没跑完，stderr 整段转出去。
    #
    # 改这条命令之后要跑上面说的那个测试，别只看推送有没有被拦。
    scan_err="$(gitleaks detect \
            --source "$repo_root" \
            --config "$repo_root/.gitleaks.toml" \
            --log-opts "--diff-merges=separate $range" \
            --exit-code "$leaks_rc" \
            --redact --verbose --no-banner --no-color 2>&1 >&3)"
    rc=$?
    case "$rc" in
        0) ;;
        "$leaks_rc") failed=1 ;;
        *)
            # 可能一行都没扫。原话整段转出去；其中若有 `[git]` 行，也已经在里面了。
            # `${rc}` 的花括号不能省：UTF-8 locale 下 macOS 的 bash 3.2 会把紧跟的全角括号
            # 的首字节读进变量名，`set -u` 下 hook 当场崩掉（2026-09-29 实测）。
            echo "pre-push: gitleaks 没有扫完就退出了（退出码 ${rc}），它的原话：" >&2
            printf '%s\n' "$scan_err" >&2
            broken=1
            continue
            ;;
    esac
    if git_err="$(printf '%s\n' "$scan_err" | grep -F '[git]')"; then
        printf '%s\n' "$git_err" >&2
        broken=1
    fi
done

[ "$failed" -eq 0 ] && [ "$broken" -eq 0 ] && exit 0

if [ "$broken" -ne 0 ]; then
    cat >&2 <<'MSG'

╔══════════════════════════════════════════════════════════════════════╗
║  推送被拦下：密钥扫描没有跑完                                        ║
╚══════════════════════════════════════════════════════════════════════╝

要推的 commit 没有扫完，所以拦下。它既不算「扫描通过」，也不算「有疑似密钥」。

  1. 按上面的原话修。原话有两种：
       - 带 `[git]` 的几行是 git 的：gitleaks 调 `git log` 时 git 失败了。gitleaks
         照样输出 `no leaks found`、返回 0。常见的是本地缺对象或 ref 坏了
         （`git fsck` 看得出来），或者刚改过这个 hook 的 `--log-opts`。
       - 「gitleaks 没有扫完就退出了」下面是 gitleaks 自己的。常见的有两种，
         都是一行没扫：`.gitleaks.toml` 不在或写坏了；规则里写了 RE2 不支持的
         正则，例如 lookahead `(?=`，gitleaks 会直接 panic。
  2. 修好之后重推，hook 会重新扫。
  3. `git push --no-verify` 能绕过这里，但后面没有网了：GitHub 的 push protection
     认不出 Binance 的密钥（不在 partner pattern 列表），CI 的 Secrets 门是事后的。

MSG
fi

# 只是扫描没跑完、没扫到疑似密钥：下面那个框不适用。
[ "$failed" -eq 0 ] && exit 1

cat >&2 <<'MSG'

╔══════════════════════════════════════════════════════════════════════╗
║  推送被拦下：将要进入远端的 commit 里有疑似密钥                      ║
╚══════════════════════════════════════════════════════════════════════╝

上面列出了命中的 commit、文件与行号（值已脱敏），每处都有一行 `RuleID:`。

注意这些 commit **已经在本地历史里了**，光改文件不够——那只会再加一个 commit，
旧的那个照样会被推上去。

  1. 真的是密钥：
       - **先让它失效**，这一步不能等，也不需要任何人批准。去哪里失效，
         看 `RuleID:` 那一行：
           RuleID 是 `beidou-lark-webhook-url`：漏的是告警 webhook 的 URL，
             token 就是它的最后一段。**在 Lark 里让这个机器人的旧地址失效**，
             换一条新地址。交易所的 key 没漏，不用动。
           别的 RuleID（本仓库里多半是 Binance 的 key）：**去交易所把它作废重发**。
         两支的完整步骤都在 SECURITY.md 第四节。
       - 新值写进凭据**此刻实际所在**的位置，替换旧值：
         `~/Library/Application Support/beidou/env.sh` 存在就写进它，
         不存在就改 `~/.zshrc` 里的 `export BEIDOU_*` 行。
         **不要为了这一步新建 `env.sh`**——文件一存在，`~/.zshrc` 就不再被读，
         其余 `BEIDOU_*` 变量会跟着消失：只放了新 key，告警 webhook 静默丢失；
         只放了 webhook，Binance 的 key 也没了，实盘循环下一次启动以 78 退出。
       - 换的是 webhook：重启 live 与 shadow（shadow 在跑的话）。它们是长驻的
         `live run`，不重启就一直用旧地址。窗口与步骤见 CLAUDE.md「重启实盘循环」。
       - 然后再处理历史：`git rebase -i` 改掉那个 commit，或者
         `git reset --soft` 回到它之前重做。
       - 记住这是**公开仓库**：一旦推上去，force push 也收不回来——
         fork、克隆、镜像、搜索引擎缓存都不归它管。

  2. 误报：往 `.gitleaks.toml` 的 allowlist 加一条，按它是什么写，
     并说明它为什么不可能是密钥。

  3. `git push --no-verify` 能绕过这里。但要知道后面没有网了：
     GitHub 的 push protection **认不出 Binance 的密钥**（不在 partner pattern
     列表，个人公开仓库也加不了 custom pattern），而 CI 的 Secrets 门是事后的——
     它红的时候，密钥已经公开可读了。告警 webhook 也一样：Lark 在
     partner pattern 列表里，但列的五类凭据里没有 webhook。

MSG
exit 1
