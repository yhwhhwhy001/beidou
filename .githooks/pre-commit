#!/bin/bash
# 北斗 V5 — 提交前密钥扫描
#
# 装法不是 `cp` 到 `.git/hooks/`：那份不进版本库，于是每个 clone、每个 `git worktree`
# 都得有人记得再装一次，而「有人记得」正是这一层想替换掉的东西。改用
# `git config core.hooksPath .githooks`（`deploy/install-hooks.sh` 做这件事），
# 目录跟着仓库走，worktree 自动继承。
#
# 这一层挡的是**手滑**，不是恶意：`git commit --no-verify` 一个开关就能绕过它，
# 任何本地 hook 都一样。它后面还有一道 pre-push，也在本机，也能这样绕过。
#
# 再往后没有网接得住 Binance 的密钥。GitHub 的 push protection 认不出它：2026-09-19 核实，
# Binance 不在 GitHub secret scanning 的 partner pattern 列表里，个人账户的公开仓库也加不了
# custom pattern。CI 的 Secrets 门是事后的，它红的时候密钥已经公开可读。所以 Binance 密钥
# 在「进入公开仓库之前」的拦截，只剩本机这两个 hook。四层各自的覆盖范围写在 SECURITY.md 第二节。
#
# 只扫**暂存区**，不扫历史：历史每次提交都扫要 6 秒，而 6 秒的 hook 三天之内就会被
# `--no-verify` 常态化绕过。暂存区扫描是毫秒级的。全历史扫描归 CI 的 Secrets 门，
# 以及 SECURITY.md「手动全量审计」那条命令。

set -uo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    cat >&2 <<'MSG'
pre-commit: 没找到 gitleaks，提交前的密钥扫描没有跑。

  安装：brew install gitleaks

这不是阻断——本地缺工具就挡住提交只会逼人绕过 hook。但要知道这次提交没有被扫过，
而 pre-push 同样靠 gitleaks，push 时也不会扫。后面没有网接得住 Binance 的密钥：
GitHub 的 push protection 认不出它（不在 partner pattern 列表，
个人公开仓库也加不了 custom pattern），CI 的 Secrets 门是事后的——
它红的时候，密钥已经公开可读了。
MSG
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
# 有命中时让 gitleaks 用这个码退出（`--exit-code`）。gitleaks 自己出错时退 1、2 或 126，
# 取一个离它们都远的值。为什么要分开，见下面那条命令上面的注释。
leaks_rc=42

# `git` 子命令用 protect --staged：它只看 `git diff --cached`，即这次真要提交的内容。
#
# `--verbose` 把每处命中打到 stdout：文件、行号、规则，值由 `--redact` 脱敏。下面的提示说
# 「上面列出了」，指的就是它。2026-09-29 之前没带这个参数，gitleaks 只在 stderr 报一句
# `leaks found`，而 stderr 丢进了 /dev/null，被拦时屏幕上什么也没列。
#
# `--exit-code`（2026-09-29 补）把「有命中」与「gitleaks 自己出错」分开，理由同 pre-push。
# gitleaks 有命中时默认退 1，可配置读不了时它也退 1。规则里有 RE2 不支持的正则时它 panic，
# 退 2。此前这里只看退出码非 0，配置坏了也出「有疑似密钥」的框。stderr 又进了 /dev/null，
# 原话看不到。现在只截 stderr，出错时把原话转出去；stdout 上的命中清单经 fd 3 照旧给终端。
# `--no-color` 让转出去的几行不带色码。gitleaks 的 FTL 那一行不听它，照样带色码。
exec 3>&1
scan_err="$(gitleaks protect --staged \
        --source "$repo_root" \
        --config "$repo_root/.gitleaks.toml" \
        --exit-code "$leaks_rc" \
        --redact --verbose --no-banner --no-color 2>&1 >&3)"
rc=$?
[ "$rc" -eq 0 ] && exit 0

if [ "$rc" -ne "$leaks_rc" ]; then
    # `${rc}` 的花括号不能省，理由见 pre-push 同一行。
    echo "pre-commit: gitleaks 没有扫完就退出了（退出码 ${rc}），它的原话：" >&2
    printf '%s\n' "$scan_err" >&2
    cat >&2 <<'MSG'

╔══════════════════════════════════════════════════════════════════════╗
║  提交被拦下：密钥扫描没有跑完                                        ║
╚══════════════════════════════════════════════════════════════════════╝

暂存区没有扫完，所以拦下。它既不算「扫描通过」，也不算「有疑似密钥」。

  1. 按上面的原话修。常见的有两种，都是一行没扫：`.gitleaks.toml` 不在或写坏了；
     规则里写了 RE2 不支持的正则，例如 lookahead `(?=`，gitleaks 会直接 panic。
  2. 修好之后重新提交，hook 会重新扫。
  3. `--no-verify` 能绕过这里。可 push 时 pre-push 读的是同一份 `.gitleaks.toml`，
     多半同样扫不完。再往后没有网接得住 Binance 的密钥：GitHub 的 push protection
     认不出它（不在 partner pattern 列表，个人公开仓库也加不了 custom pattern），
     CI 的 Secrets 门是事后的——它红的时候，密钥已经公开可读了。

MSG
    exit 1
fi

cat >&2 <<'MSG'

╔══════════════════════════════════════════════════════════════════════╗
║  提交被拦下：暂存区里有疑似密钥                                      ║
╚══════════════════════════════════════════════════════════════════════╝

上面列出了命中的文件与行号（值已脱敏），每处都有一行 `RuleID:`。按这个顺序处理：

  1. 先看它是不是真的密钥。本仓库的 construction fingerprint、sha256 摘要、
     git object id 都是纯 hex，`.gitleaks.toml` 已经放行；还能红说明形态不同。

  2. 真的是密钥：先把值从文件里删掉，改成从环境读。写进过文件的密钥就当
     已经泄漏，哪怕它一次都没被提交——本机可能有备份、编辑器可能有 swap、
     Time Machine 可能已经存了一份。接着看 `RuleID:` 那一行，两支处置不同。

     RuleID 是 `beidou-lark-webhook-url`：漏的是告警 webhook 的 URL。
       - **在 Lark 里让这个机器人的旧地址失效**，换一条新地址。
         token 就是 URL 的最后一段。交易所的 key 没漏，不用动。
       - 新地址替换 `BEIDOU_ALERTS_WEBHOOK_URL` 的旧值，写到哪见下面。
       - 重启 live 与 shadow（shadow 在跑的话）。它们是长驻的 `live run`，
         不重启就一直用旧地址。窗口与步骤见 CLAUDE.md「重启实盘循环」。
         别的 launchd job 每次启动都重读凭据，不用管。
       - 完整步骤见 SECURITY.md 第四节「漏的是告警 webhook」。

     别的 RuleID（本仓库里多半是 Binance 的 key）：
       - **去交易所把这个 key 作废重发**。
       - 新 key 替换旧值，写到哪见下面。
       - 其余步骤（确认损失、重启循环）见 SECURITY.md 第四节。

     写到哪：凭据**此刻实际所在**的位置。
       `~/Library/Application Support/beidou/env.sh` 存在就写进它，
       不存在就改 `~/.zshrc` 里的 `export BEIDOU_*` 行。
       **不要为了这一步新建 `env.sh`**——文件一存在，`~/.zshrc` 就不再被读，
       其余 `BEIDOU_*` 变量会跟着消失：只放了新 key，告警 webhook 静默丢失；
       只放了 webhook，Binance 的 key 也没了，实盘循环下一次启动以 78 退出。

  3. 确认是误报：往 `.gitleaks.toml` 的 allowlist 加一条，**按它是什么写**
     （形态或具体值），不要按目录整片放行，并写一句它为什么不可能是密钥。

  4. 只有在 2 和 3 都不适用、而你确知在做什么时才用 `--no-verify`。
     它绕过的只有本机这一层，push 时 pre-push 还会再扫一遍。但 pre-push
     也能被 `--no-verify` 绕过，而再往后没有网接得住 Binance 的密钥：
     GitHub 的 push protection 认不出它（不在 partner pattern 列表，
     个人公开仓库也加不了 custom pattern），CI 的 Secrets 门是事后的——
     它红的时候，密钥已经公开可读了。告警 webhook 也一样：Lark 在
     partner pattern 列表里，但列的五类凭据里没有 webhook。

MSG
exit 1
