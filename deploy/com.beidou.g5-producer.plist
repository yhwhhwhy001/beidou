<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidou.g5-producer</string>

    <!--
      G5-only launchd template.  This service is loaded only by the approved
      Testnet certification runner and is never the normal autopilot service.
      The producer keeps the engine in NO_NEW_RISK and hard-holds all engine
      terminal writes; the G5 runner owns its separately bounded probes.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/maguannan/beidou/deploy/beidou_launchd_wrapper.sh</string>
        <string>/Users/maguannan/beidou/.venv/bin/python</string>
        <string>-m</string>
        <string>beidou_launcher</string>
        <string>g5-producer</string>
        <string>--mode</string>
        <string>testnet</string>
        <string>--symbols</string>
        <string>BTCUSDT</string>
        <string>--port</string>
        <string>9090</string>
        <string>--confirm-g5-producer</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maguannan/beidou</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BEIDOU_ENV</key>
        <string>testnet</string>
        <key>BEIDOU_G5_PRODUCER</key>
        <string>1</string>
        <key>BEIDOU_TERMINAL_WRITE_HOLD</key>
        <string>hard</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/maguannan/beidou/.beidou/g5-producer.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maguannan/beidou/.beidou/g5-producer.stderr.log</string>
</dict>
</plist>
