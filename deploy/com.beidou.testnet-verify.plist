<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  北斗 Testnet 唯一验证入口 (apps.testnet_verify) 的 launchd 定义。

  安装:
    cp deploy/com.beidou.testnet-verify.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.beidou.testnet-verify.plist

  语义:
    - RunAtLoad + KeepAlive=true: 常驻持续决策循环; 异常退出自动拉起
      (ThrottleInterval 30 防止崩溃快速循环)
    - 密钥由 wrapper 从仓库 .env 注入, 本 plist 不携带任何秘密
    - 日志写到仓库之外, 避免污染 git 树 (会阻断引擎启动预检)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidou.testnet-verify</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/maguannan/beidou/deploy/beidou_testnet_verify.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maguannan/beidou</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/maguannan/Library/Application Support/beidou-testnet-verify/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maguannan/Library/Application Support/beidou-testnet-verify/stderr.log</string>
</dict>
</plist>
