<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidou.autopilot</string>

    <!--
      Safety template only.  It is not installed or loaded automatically.
      Credentials must come from an approved provider; no shell/eval or
      secret values are embedded in this file.  Missing credentials fail the
      preflight gate and therefore cannot enable trading.

      M22-F02: 模板不得携带 no-self-heal 参数 —— P0-01 教训:该参数
      关闭故障自愈与 testnet 自动重新授权链,部署后控制面会卡
      NO_NEW_RISK。自愈默认开启(CLI 默认 self-heal),需要显式关停时
      由操作者在部署时决定。注: XML 注释禁双连字符,故不写出参数名。
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/beidou</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maguannan/beidou</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BEIDOU_ENV</key>
        <string>safety_only</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Never restart a failed/LOCKED process without a governed watchdog. -->
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/maguannan/beidou/.beidou/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maguannan/beidou/.beidou/launchd.stderr.log</string>
</dict>
</plist>
