<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidou.autopilot</string>

    <!--
      Safety template only.  It is not installed or loaded automatically.
      Credentials must come from an approved provider; no shell/eval or
      secret values are embedded in this file.  Missing credentials fail the
      preflight gate and therefore cannot enable trading.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/beidou</string>
        <string>start</string>
        <string>--mode</string>
        <string>testnet</string>
        <string>--symbols</string>
        <string>DEFAULT</string>
        <string>--no-self-heal</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maguannan/beidou</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BEIDOU_ENV</key>
        <string>testnet</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Never restart a failed/LOCKED process without a governed watchdog. -->
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/maguannan/beidou/.beidou/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maguannan/beidou/.beidou/launchd.stderr.log</string>
</dict>
</plist>
