<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidou.autopilot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>eval "$(grep '^export BEIDOU_' /Users/maguannan/.zshrc)" &amp;&amp; export BEIDOU_ENV=testnet PYTHONUNBUFFERED=1 &amp;&amp; /opt/homebrew/bin/beidou start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maguannan/beidou</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/beidou_launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/beidou_launchd_err.log</string>
</dict>
</plist>
