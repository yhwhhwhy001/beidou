{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beidou Evidence Manifest",
  "type": "object",
  "required": [
    "task_id",
    "commit",
    "branch",
    "command",
    "exit_code",
    "started_at",
    "finished_at",
    "stdout_sha256",
    "stderr_sha256",
    "agent_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^BD-T[0-9]{2}$"
    },
    "commit": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "config_hash": {
      "type": "string"
    },
    "policy_versions": {
      "type": "object"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "stdout_path": {
      "type": "string"
    },
    "stderr_path": {
      "type": "string"
    },
    "stdout_sha256": {
      "type": "string"
    },
    "stderr_sha256": {
      "type": "string"
    },
    "artifact_hashes": {
      "type": "object"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "CONDITIONAL_PASS",
        "FAIL",
        "NOT_VERIFIABLE"
      ]
    }
  }
}
