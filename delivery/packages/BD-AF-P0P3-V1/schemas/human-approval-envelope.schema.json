{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/human-approval-envelope.schema.json",
  "type": "object",
  "required": ["schema_version", "package_id", "package_fingerprint", "signature_namespace", "task_id", "baseline_commit", "approved_worktree", "protected_source_worktree", "scope", "approval_ids", "owner_bindings", "dependency_result_sha256", "expires_at", "approver"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "package_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_namespace": {"type": "string", "const": "beidou-alpha-first-task-approval-v1"},
    "task_id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approved_worktree": {"type": "string", "pattern": "^/"},
    "protected_source_worktree": {"type": "string", "pattern": "^/"},
    "scope": {"type": "string", "const": "LOCAL_IMPLEMENTATION_ONLY"},
    "approval_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "owner_bindings": {"type": "object"},
    "dependency_result_sha256": {"type": "object"},
    "expires_at": {"type": "string", "minLength": 20},
    "approver": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
