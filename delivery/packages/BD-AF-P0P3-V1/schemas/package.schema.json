{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/package.schema.json",
  "type": "object",
  "required": ["$schema", "schema_version", "package_id", "package_version", "created_at", "maturity", "package_spec_decision", "implementation_authorization", "approval_trust_root_sha256", "runtime_authorization", "mainnet_authorization", "source_snapshot", "source_decision", "authority", "included_phases", "deferred_phases", "task_count", "in_scope_requirement_count", "human_approval_requirements", "implementation_hold_reasons", "economic_truth", "testnet_truth", "mainnet_absence_current_artifact"],
  "properties": {
    "$schema": {"type": "string", "const": "schemas/package.schema.json"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "minLength": 20},
    "maturity": {"type": "string", "const": "DEVELOPMENT_PLAN_ONLY"},
    "package_spec_decision": {"type": "string", "enum": ["PASS_WITH_CONDITIONS", "FAIL"]},
    "implementation_authorization": {"type": "string", "const": "EXTERNAL_HUMAN_ENVELOPE_REQUIRED"},
    "approval_trust_root_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "runtime_authorization": {"type": "string", "const": "NOT_AUTHORIZED"},
    "mainnet_authorization": {"type": "string", "const": "PROHIBITED"},
    "source_snapshot": {
      "type": "object",
      "required": ["repository", "commit", "branch", "clean", "protected_dirty_paths", "protected_tracked_paths", "protected_untracked_paths", "ignored_generated_untracked_prefixes", "protected_entries_sha256", "implementation_baseline_commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string", "minLength": 1},
        "clean": {"type": "boolean"},
        "protected_dirty_paths": {"type": "integer", "minimum": 0},
        "protected_tracked_paths": {"type": "integer", "minimum": 0},
        "protected_untracked_paths": {"type": "integer", "minimum": 0},
        "ignored_generated_untracked_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+/$"}},
        "protected_entries_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "implementation_baseline_commit": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source_decision": {
      "type": "object",
      "required": ["decision", "path", "sha256"],
      "properties": {
        "decision": {"type": "string", "const": "PIVOT_VERTICAL_SLICE_STRANGLER"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["local_package_validation", "local_deterministic_archive_build", "implementation_code_changes", "modify_preexisting_worktree_changes", "git_mutation_or_push", "paper_or_testnet_action", "exchange_or_account_access", "deployment_or_activation", "mainnet_or_real_funds"],
      "properties": {
        "local_package_validation": {"type": "boolean", "const": true},
        "local_deterministic_archive_build": {"type": "boolean", "const": true},
        "implementation_code_changes": {"type": "boolean", "const": false},
        "modify_preexisting_worktree_changes": {"type": "boolean", "const": false},
        "git_mutation_or_push": {"type": "boolean", "const": false},
        "paper_or_testnet_action": {"type": "boolean", "const": false},
        "exchange_or_account_access": {"type": "boolean", "const": false},
        "deployment_or_activation": {"type": "boolean", "const": false},
        "mainnet_or_real_funds": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "included_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-8]$"}},
    "deferred_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-8]$"}},
    "task_count": {"type": "integer", "minimum": 1},
    "in_scope_requirement_count": {"type": "integer", "minimum": 1},
    "human_approval_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "implementation_hold_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "economic_truth": {"type": "string", "const": "NOT_VERIFIABLE"},
    "testnet_truth": {"type": "string", "const": "NOT_AUTHORIZED"},
    "mainnet_absence_current_artifact": {"type": "string", "const": "NOT_PROVEN_OUT_OF_SCOPE"}
  },
  "additionalProperties": false
}
