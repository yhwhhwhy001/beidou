{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/task-result.schema.json",
  "type": "object",
  "required": ["schema_version", "package_id", "package_fingerprint", "task_id", "baseline_commit", "actual_head", "dependency_result_sha256", "approval_relative_path", "approval_sha256", "approval_signature_relative_path", "approval_signature_sha256", "evidence_manifests", "changed_paths", "implementer_identity", "implementer_status", "reviewer_status", "reviewer_identity", "reviewed_at", "reviewer_record_relative_path", "reviewer_record_sha256", "reviewer_signature_relative_path", "reviewer_signature_sha256", "residual_risks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "package_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actual_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_result_sha256": {"type": "object"},
    "approval_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
    "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_signature_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
    "approval_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_manifests": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["criterion_id", "relative_path", "sha256", "status"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^(AC-BD-AF-P[0-3]-T[0-9]{2}-[0-9]{2}|RB-BD-AF-P[0-3]-T[0-9]{2})$"},
          "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"type": "string", "const": "PASS"}
        }, "additionalProperties": false
      }
    },
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"}},
    "implementer_identity": {"type": "string", "minLength": 1},
    "implementer_status": {"type": "string", "enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "NOT_VERIFIABLE"]},
    "reviewer_status": {"type": ["string", "null"], "enum": ["ACCEPTED", "REJECTED", "HOLD", null]},
    "reviewer_identity": {"type": ["string", "null"], "minLength": 1},
    "reviewed_at": {"type": ["string", "null"], "minLength": 20},
    "reviewer_record_relative_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
    "reviewer_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reviewer_signature_relative_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
    "reviewer_signature_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "residual_risks": {
      "type": "array", "items": {
        "type": "object", "required": ["severity", "statement"],
        "properties": {
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "statement": {"type": "string", "minLength": 8}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
