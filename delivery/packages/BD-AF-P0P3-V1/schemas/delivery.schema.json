{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/delivery.schema.json",
  "type": "object",
  "required": ["$schema", "schema_version", "package_id", "requirements", "deferred_requirements", "tasks"],
  "properties": {
    "$schema": {"type": "string", "const": "schemas/delivery.schema.json"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "requirements": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["id", "priority", "title", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^AF-REQ-[0-9]{3}$"},
          "priority": {"type": "string", "enum": ["P0", "P1"]},
          "title": {"type": "string", "minLength": 8},
          "status": {"type": "string", "const": "IN_SCOPE"}
        }, "additionalProperties": false
      }
    },
    "deferred_requirements": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "phase", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^AF-REQ-[0-9]{3}$"},
          "phase": {"type": "string", "pattern": "^P[4-8]$"},
          "reason": {"type": "string", "minLength": 8}
        }, "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["id", "phase", "priority", "title", "path", "dependencies", "requirement_ids", "allowed_path_prefixes", "owner_role", "reviewer_role", "initial_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
          "phase": {"type": "string", "pattern": "^P[0-3]$"},
          "priority": {"type": "string", "enum": ["P0", "P1"]},
          "title": {"type": "string", "minLength": 8},
          "path": {"type": "string", "pattern": "^task-packages/BD-AF-P[0-3]-T[0-9]{2}$"},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"}},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AF-REQ-[0-9]{3}$"}},
          "allowed_path_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^*?]+$"}},
          "owner_role": {"type": "string", "minLength": 5},
          "reviewer_role": {"type": "string", "minLength": 5},
          "initial_status": {"type": "string", "pattern": "^HOLD_[A-Z0-9_]+$"}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
