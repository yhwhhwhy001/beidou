{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/acceptance.schema.json",
  "type": "object",
  "required": ["$schema", "schema_version", "task_id", "dependencies", "preflight", "criteria", "completion", "rollback_rehearsal"],
  "properties": {
    "$schema": {"type": "string", "const": "../../schemas/acceptance.schema.json"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"}},
    "preflight": {
      "type": "object", "required": ["worktree", "dependency_status", "approval_ids", "network_policy"],
      "properties": {
        "worktree": {"type": "string", "const": "CLEAN_APPROVED_BASELINE"},
        "dependency_status": {"type": "string", "enum": ["ACCEPTED", "NOT_APPLICABLE_NO_DEPENDENCIES"]},
        "approval_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "network_policy": {"type": "string", "const": "DENIED"}
      }, "additionalProperties": false
    },
    "criteria": {
      "type": "array", "minItems": 2, "items": {
        "type": "object", "required": ["id", "requirement_ids", "mandatory", "statement", "oracle", "evidence", "failure_action"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-BD-AF-P[0-3]-T[0-9]{2}-[0-9]{2}$"},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AF-REQ-[0-9]{3}$"}},
          "mandatory": {"type": "boolean", "const": true},
          "statement": {"type": "string", "minLength": 12},
          "oracle": {
            "type": "object", "required": ["phase", "argv", "cwd", "timeout_seconds", "network_policy", "expected_exit_codes", "test_expectation"],
            "properties": {
              "phase": {"type": "string", "enum": ["PRE_IMPLEMENTATION_CHARACTERIZATION", "POST_IMPLEMENTATION"]},
              "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
              "cwd": {"type": "string", "const": "REPO_ROOT"},
              "timeout_seconds": {"type": "integer", "minimum": 1},
              "network_policy": {"type": "string", "const": "DENIED"},
              "expected_exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
              "test_expectation": {
                "type": ["object", "null"],
                "properties": {
                  "junit_path": {"type": "string", "minLength": 1},
                  "minimum_collected": {"type": "integer", "minimum": 1},
                  "maximum_skipped": {"type": "integer", "minimum": 0},
                  "maximum_xfailed": {"type": "integer", "minimum": 0}
                },
                "required": ["junit_path", "minimum_collected", "maximum_skipped", "maximum_xfailed"],
                "additionalProperties": false
              }
            }, "additionalProperties": false
          },
          "evidence": {
            "type": "object", "required": ["kind", "artifacts"],
            "properties": {
              "kind": {"type": "string", "enum": ["COMMAND", "JUNIT", "MANIFEST", "DIFFERENTIAL", "MUTATION", "REHEARSAL"]},
              "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
            }, "additionalProperties": false
          },
          "failure_action": {"type": "string", "minLength": 12}
        }, "additionalProperties": false
      }
    },
    "completion": {
      "type": "object", "required": ["required_status", "independent_review", "zero_open_p0_p1", "evidence_manifest_required"],
      "properties": {
        "required_status": {"type": "string", "const": "PASS"},
        "independent_review": {"type": "boolean", "const": true},
        "zero_open_p0_p1": {"type": "boolean", "const": true},
        "evidence_manifest_required": {"type": "boolean", "const": true}
      }, "additionalProperties": false
    },
    "rollback_rehearsal": {
      "type": "object", "required": ["required", "command", "timeout_seconds", "network_policy", "expected_exit_codes", "test_expectation", "evidence", "success_oracle", "failure_action"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "network_policy": {"type": "string", "const": "DENIED"},
        "expected_exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "test_expectation": {
          "type": ["object", "null"],
          "properties": {
            "junit_path": {"type": "string", "minLength": 1},
            "minimum_collected": {"type": "integer", "minimum": 1},
            "maximum_skipped": {"type": "integer", "minimum": 0},
            "maximum_xfailed": {"type": "integer", "minimum": 0}
          },
          "required": ["junit_path", "minimum_collected", "maximum_skipped", "maximum_xfailed"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object", "required": ["kind", "artifacts"],
          "properties": {
            "kind": {"type": "string", "const": "REHEARSAL"},
            "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
          }, "additionalProperties": false
        },
        "success_oracle": {"type": "string", "minLength": 12},
        "failure_action": {"type": "string", "minLength": 12}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
