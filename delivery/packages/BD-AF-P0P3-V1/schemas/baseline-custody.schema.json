{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/baseline-custody.schema.json",
  "type": "object",
  "required": ["schema_version", "capture_mode", "repository", "head", "tracked_change_count", "untracked_change_count", "ignored_untracked_prefixes", "entries", "entries_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "capture_mode": {"type": "string", "const": "TRACKED_AND_UNTRACKED_CHANGES_NO_CONTENT"},
    "repository": {"type": "string", "pattern": "^/"},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tracked_change_count": {"type": "integer", "minimum": 1},
    "untracked_change_count": {"type": "integer", "minimum": 0},
    "ignored_untracked_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+/$"}},
    "entries": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["path", "status", "kind", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"},
          "status": {"type": "string", "enum": ["?", "A", "C", "D", "M", "R", "T", "U", "X", "B"]},
          "kind": {"type": "string", "enum": ["REGULAR", "SYMLINK", "DELETED", "OTHER"]},
          "sha256": {"type": ["string", "null"]}
        }, "additionalProperties": false
      }
    },
    "entries_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
