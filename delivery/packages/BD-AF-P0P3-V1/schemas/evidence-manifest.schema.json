{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/evidence-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "package_id", "package_sha256", "task_id", "criterion_id", "baseline_commit", "actual_head", "worktree_clean", "argv", "execution_argv", "network_enforcer", "cwd", "network_policy", "timeout_seconds", "started_at", "finished_at", "exit_code", "stdout_sha256", "stderr_sha256", "junit", "artifact_sha256", "status", "failure_reason"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
    "criterion_id": {"type": "string", "pattern": "^(AC-BD-AF-P[0-3]-T[0-9]{2}-[0-9]{2}|RB-BD-AF-P[0-3]-T[0-9]{2})$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actual_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_clean": {"type": "boolean"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "network_enforcer": {"type": "string", "enum": ["MACOS_SANDBOX_EXEC_DENY_NETWORK", "UNAVAILABLE_FAIL_CLOSED"]},
    "cwd": {"type": "string", "minLength": 1},
    "network_policy": {"type": "string", "const": "DENIED"},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "minLength": 20},
    "finished_at": {"type": "string", "minLength": 20},
    "exit_code": {"type": "integer"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "junit": {"type": ["object", "null"]},
    "artifact_sha256": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "NOT_VERIFIABLE"]},
    "failure_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
