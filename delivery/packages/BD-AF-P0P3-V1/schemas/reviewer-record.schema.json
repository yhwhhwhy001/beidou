{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reviewer-record.schema.json",
  "type": "object",
  "required": ["schema_version", "package_id", "package_fingerprint", "signature_namespace", "task_id", "baseline_commit", "actual_head", "dependency_result_sha256", "approval_sha256", "approval_signature_sha256", "evidence_manifest_sha256", "changed_paths", "implementer_identity", "implementer_status", "decision", "reviewer_identity", "reviewed_at", "residual_risks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^BD-AF-P0P3-V[0-9]+$"},
    "package_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_namespace": {"type": "string", "const": "beidou-alpha-first-task-review-v1"},
    "task_id": {"type": "string", "pattern": "^BD-AF-P[0-3]-T[0-9]{2}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actual_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_result_sha256": {"type": "object"},
    "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_manifest_sha256": {"type": "object"},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"}},
    "implementer_identity": {"type": "string", "minLength": 1},
    "implementer_status": {"type": "string", "const": "PASS"},
    "decision": {"type": "string", "const": "ACCEPTED"},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 20},
    "residual_risks": {
      "type": "array", "items": {
        "type": "object", "required": ["severity", "statement"],
        "properties": {
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "statement": {"type": "string", "minLength": 8}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
