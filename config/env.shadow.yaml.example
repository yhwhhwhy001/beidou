# 北斗 Shadow 环境配置示例
# 复制为 config/env.shadow.yaml 后填入实际值
# 禁止将包含真实密钥的文件提交到版本控制

environment: shadow
version: "2.0.0"

database:
  url: "sqlite:///beidou_state.db"
  pool_min: 1
  pool_max: 5

exchange:
  binance_usdm:
    rest_base_url: "https://testnet.binancefuture.com"
    ws_base_url: "wss://testnet.binancefuture.com/ws"
    # 密钥通过环境变量注入，禁止在此文件中填写明文:
    #   BEIDOU_BINANCE_API_KEY
    #   BEIDOU_BINANCE_API_SECRET

risk:
  max_leverage: 3.0
  max_concentration_pct: 50.0
  max_position_notional: 500000.0
